{
  "ConnectionStrings": {
    "PostgreSql": ""
  },
  "Cors": {
    "PolicyName": "DefaultCorsPolicy",
    "AllowedOrigins": [
      "https://localhost:3000",
      "https://localhost:4200",
      "https://localhost:5173"
    ]
  },
  "Jwt": {
    "Key": "CleanArchitectureSuperSecretSigningKeyThatIsAtLeast32BytesLong!",
    "Issuer": "CleanArchitecture",
    "Audience": "CleanArchitectureClient",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Email": {
    "Host": "",
    "Port": 587,
    "EnableSsl": true,
    "Username": "",
    "Password": "",
    "From": "no-reply@cleanarchitecture.local",
    "FromName": "CleanArchitecture System",
    "BaseUrl": "https://localhost:5000",
    "ClientUrl": "https://localhost:3000"
  },
  "Cloudinary": {
    "CloudName": "",
    "ApiKey": "",
    "ApiSecret": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ]
  }
}
